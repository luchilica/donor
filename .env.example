# Настройки проекта
APP_URL=http://localhost:3000
VITE_API_URL= # URL вашего бэкенда на Railway (например, https://your-backend.railway.app/api)

# Сервер (Railway задаёт PORT автоматически; локально по умолчанию 3000).
# NODE_ENV в продакшене должен быть "production" — это уже выставляется
# скриптом "npm start". Указывать вручную обычно не требуется.
PORT=3000
# NODE_ENV=production

# Авторизация: приложение выдаёт подписанные session-токены (HMAC-SHA256).
# ОБЯЗАТЕЛЬНО задайте SESSION_SECRET в продакшене (длинная случайная строка,
# минимум 16 символов), иначе при каждом рестарте секрет генерируется заново и
# все активные сессии инвалидируются. Сгенерировать: `openssl rand -hex 48`.
SESSION_SECRET=

# CORS: список разрешённых origin через запятую (например,
# https://your-app.vercel.app,https://donor-alert.by). Если пусто — origin
# отражается как есть (удобно для локальной разработки).
ALLOWED_ORIGINS=

# Разрешить деструктивные изменения схемы при автодеплое (prisma db push
# --accept-data-loss). По умолчанию выключено, чтобы случайно не удалить данные.
# ALLOW_DB_DATA_LOSS=true

# Supabase PostgreSQL
# ВАЖНО для Railway: используйте Pooler-хост на порту 6543 с ?pgbouncer=true,
# т.к. прямой хост (5432) у новых проектов Supabase только IPv6 и будет зависать.
# Пример: postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# DIRECT_URL — прямое подключение (порт 5432) для миграций prisma db push.
DIRECT_URL=

# Email Delivery (SMTP / Gmail App Password)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST= (Опционально. Если @gmail.com - не нужен, иначе например smtp.yandex.ru)
SMTP_PORT= (Опционально. По умолчанию 465)

# OneSignal Web Push
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
